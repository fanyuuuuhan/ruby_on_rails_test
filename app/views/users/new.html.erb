<div class="w-auto flex flex-col justify-center gap-5 ">
  <h1 class="font-bold text-4xl"><%=t(".signup")%></h1>
  <%= form_with url: signup_path, method: :post, local: true do |form| %>
    <div class="flex flex-col gap-5">
      <div>
        <%= form.label :name, t(".name") %>
        <%= form.text_field :name, class: "border border-gray-300 rounded-md p-2 w-full" %>
      </div>

      <div>
        <%= form.label :email, t(".email") %>
        <%= form.email_field :email, class: "border border-gray-300 rounded-md p-2 w-full" %>
      </div>

      <div>
        <%= form.label :password, t(".password") %>
        <%= form.password_field :password, class: "border border-gray-300 rounded-md p-2 w-full" %>
      </div>

      <div>
        <%= form.label :password_confirmation, t(".password_confirmation") %>
        <%= form.password_field :password_confirmation, class: "border border-gray-300 rounded-md p-2 w-full" %>
      </div>

      <% if @user&.errors&.any? %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
          <strong class="font-bold"><%= t(".error") %>:</strong>
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
    <div class="flex gap-5 mt-2">
      <%= form.submit t(".signup"), class: "bg-blue-100 text-black my-2 hover:bg-blue-300 font-bold py-2 px-4 rounded" %>
    </div>
  <% end %>
  <div class="flex flex-col gap-5">
    <div class="flex gap-2">
     <p class="text-sm text-gray-600"><%= t(".account") %></p>
     <%= link_to t(".login"), login_path, class: "text-blue-500 hover:text-blue-700" %>
    </div>
    <%= link_to t(".back"), tasks_path, class: "w-auto flex justify-center text-md bg-gray-200 text-black my-2 hover:bg-gray-300 font-bold py-2 px-4 rounded" %>
  </div>
</div>
