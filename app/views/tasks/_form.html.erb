
<% if @task.errors.any? %>
  <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
    <strong class="font-bold"><%= t(".error") %>:</strong>
    <ul>
      <% task.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with(
            model: @task, 
            html: { class: "space-y-4 px-5" }
            ) do |form|%>
  <div>
    <%= form.label :title, t(".form_title") %>
    <%= form.text_field :title,
        class:"border border-gray-300 rounded-md p-2 w-full" %>
  </div>

  <div>
    <%= form.label :content, t(".form_content") %>
    <%= form.text_area :content, 
        class:"border border-gray-300 rounded-md p-2 w-full" %>
  </div>

  <div>
    <%= form.label :status, t(".form_status") %>
    <%= form.select :status, options_for_select([[t(".pending"), 'pending'], [t(".in_progress"), 'in_progress'], [t(".completed"), 'completed']]) %>
  </div>

  <div>
    <%= form.label :due_date, t(".form_due_date") %>
    <%= form.date_field :due_date, 
        class:"border border-gray-300 rounded-md p-2 w-full" %>
  </div>

  <div>
    <%= form.submit (
        @task.new_record? ? t(".add_task") : t(".update_task")) ,
        class:"bg-blue-100 text-black my-2 hover:bg-blue-300 font-bold py-2 px-4 rounded" %>
  </div>
<% end %>