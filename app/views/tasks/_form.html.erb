
<% if @task.errors.any? %>
  <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
    <strong class="font-bold"><%= t(".error") %>:</strong>
    <ul>
      <% @task.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with(
      model: @task,
      local: true,
      data: { turbo: false },
      html: { class: "space-y-4 px-5", novalidate: true }
    ) do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title,
        class:"border border-gray-300 rounded-md p-2 w-full" %>
  </div>

  <div>
    <%= form.label :content %>
    <%= form.text_area :content,
        class:"border border-gray-300 rounded-md p-2 w-full" %>
  </div>

  <div>
    <%= form.label :status %>
    <%= form.select :status, 
      options_for_select([[t(".pending"), 'pending'],
      [t(".in_progress"), 'in_progress'],
      [t(".completed"), 'completed']]) %>
  </div>

  <div>
    <%= form.label :due_date %>
    <%= form.date_field :due_date,
        class:"border border-gray-300 rounded-md p-2 w-full" %>
  </div>

  <div>
    <%= form.label :priority %>
    <%= form.select :priority, 
      options_for_select([[t(".low"), 'low'],
      [t(".medium"), 'medium'],
      [t(".high"), 'high']]) %>
  </div>

  <div>
    <%= form.label :tag_names, t(".tags") %>
    <%= form.text_field :tag_names,
      placeholder: t(".tags_placeholder"),
      class:"border border-gray-300 rounded-md p-2 w-full" %>
  </div> 

  <div>
    <%= form.submit (
        @task.new_record? ? t(".add_task") : t(".update_task")) ,
        class:"bg-blue-100 text-black my-2 hover:bg-blue-300 font-bold py-2 px-4 rounded" %>
  </div>
<% end %>