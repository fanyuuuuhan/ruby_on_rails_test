
  <h1 class="font-bold text-4xl">任務列表</h1>


<%=link_to "新增任務", new_task_path %>
<%if @tasks.any?%>
  <ul>
    <% @tasks.each do |task| %>
      <li>
        <%= link_to task.title, task_path(task),
        class:"mx-5 px-4 py-2 " %>
        <%= link_to "編輯", edit_task_path(task) ,
        class:"px-4 pt-5 font-bold" %>
        <%= link_to "刪除", task_path(task),
                           data: { 
                            turbo_method: :delete,
                            turbo_confirm: "確定要刪除嗎？" 
                            } ,
                            class:"px-4 pt-5 font-bold" %>
      </li>
    <% end %>
  </ul>
  <%else%>
   <p>目前沒有任務</p>
  <%end%>