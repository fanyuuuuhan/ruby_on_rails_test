

  <h1 class="font-bold text-4xl"><%= t(".title") %></h1>



<%=link_to t(".new"), new_task_path %>
<%if @tasks.any?%>
  <ul>
    <% @tasks.each do |task| %>
      <li>
        <%= link_to task.title, task_path(task),
        class:"mx-5 px-4 py-2 " %>
        <%= link_to t(".edit"), edit_task_path(task) ,
        class:"px-4 pt-5 font-bold" %>
        <%= link_to t(".delete"), task_path(task),
                           data: { 
                            turbo_method: :delete,
                            turbo_confirm: t(".delete_check") 
                            } ,
                            class:"px-4 pt-5 font-bold" %>
      </li>
    <% end %>
  </ul>
  <%else%>
   <p><%= t(".empty") %></p>
  <%end%>