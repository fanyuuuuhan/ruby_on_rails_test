

<div class="w-full flex justify-center gap-10 ">

  <% if current_user %>
    <div class="flex flex-col gap-5 items-center">
      <h1 class="font-bold text-3xl w-auto"><%= t(".title") %></h1>
      <% flash.each do |type, message| %>
        <div class="alert alert-<%= type %> text-red-600 items-center justify-center">
          <%= message %>
        </div>
      <% end %>
      <%= link_to t(".new"), new_task_path,
      class: "px-5 items-center justify-center" %>
      <%= link_to t(".admin_title"), admin_root_path if current_user&.admin? %>
      <div class="flex items-center justify-center">
        <%= button_to t(".logout"), logout_path, method: :delete,
        class: "w-auto text-center px-5 py-2 items-center justify-center border border-gray-500 hover:bg-indigo-400 rounded hover:text-white" %>
      </div>
    </div>

  <% if @tasks.any? %>
    <div class="flex flex-col gap-5 w-[65%]">
      <ul class="space-y-5">
        <% @tasks.each do |task| %>
          <li class="flex justify-between items-center gap-3 p-4 border rounded">
            <%= turbo_frame_tag dom_id(task), class: "flex-1" do %>
              <%= render "task", task: task %>
              <% if task.due_date.present? %>
                <p class="text-sm text-gray-500 ml-auto">
                  <%= t(".due_date") %>: <%= task.due_date.strftime("%Y-%m-%d") %>
                </p>
              <% end %>
              <%= task.user.name %>
            <% end %>
            <%= link_to t(".delete"), task_path(task),
              data: {
                turbo_method: :delete,
                turbo_confirm: t(".delete_check")
              },
              class: "px-4 py-2 font-bold bg-pink-100" %>
          </li>
        <% end %>
      </ul>
      <div class="pagies">
        <%== @pagy.series_nav(slots: 7) if @pagy.pages > 1 %>
      </div>
    </div>
  <% else %>
    <p><%= t(".empty") %></p>
  <% end %>

  <%= form_with url: tasks_path,
      html: { class: "px-5 text-sm" },
      method: :get, local: true do |form| %>
    <div class="flex flex-col gap-2">
      <%= form.select :sort_order,
        options_for_select(
          [[t(".sort_created_at_asc"), "created_at_asc"], [t(".sort_created_at_desc"), "created_at_desc"], [t(".sort_title_asc"), "title_asc"], [t(".sort_due_date_asc"), "due_date_asc"], [t(".sort_due_date_desc"), "due_date_desc"], [t(".sort_priority_asc"), "priority_asc"], [t(".sort_priority_desc"), "priority_desc"]],
          params[:sort_order]
        ), {}, { onchange: "this.form.submit();" } %>

      <%= form.label :title_cont, t(".search_title") %>
      <%= form.text_field :title_cont,
        value: params[:title_cont], placeholder: t(".search_input_title"),
        class: "border border-gray-300 rounded-md p-2" %>

      <%= form.label :status_eq, t(".search_status") %>
      <%= form.select :status_eq,
        options_for_select(
          [["", ""]] + Task.statuses.keys.map do |status|
            [t("tasks.form.#{status}"), status]
          end,
          params[:status_eq]
        ), {}, { onchange: "this.form.submit();" } %>

      <%= form.label :priority_eq, t(".search_priority") %>
      <%= form.select :priority_eq,
        options_for_select(
          [["", ""]] + Task.priorities.keys.map do |priority|
            [t("tasks.form.#{priority}"), priority]
          end,
          params[:priority_eq]
        ), {}, { onchange: "this.form.submit();" } %>

      <%= form.label :due_date_gteq, t(".search_due_date_start") %>
      <%= form.date_field :due_date_gteq,
        value: params[:due_date_gteq],
        class: "border border-gray-300 rounded-md p-2" %>
      <%= form.label :due_date_lteq, t(".search_due_date_end") %>
      <%= form.date_field :due_date_lteq,
        value: params[:due_date_lteq],
        class: "border border-gray-300 rounded-md p-2" %>

      <%= form.label :tag_names, t(".search_by_tag") %>
      <%= form.text_field :tag_names,
        value: params[:tag_names], placeholder: t(".search_input_by_tag"),
        class: "border border-gray-300 rounded-md p-2" %>

      <%= form.submit t(".search_button"), class: "bg-blue-100 text-black my-2 hover:bg-blue-300 font-bold py-2 px-4 rounded" %>
    </div>
  <% end %>

  <% else %>
    <div class="flex flex-col gap-5">
      <h1 class="font-bold text-3xl"><%= t(".title") %></h1>
      <%= link_to t(".login"), login_path,
      class: "w-auto text-center px-5 py-2 items-center justify-center border border-gray-500 hover:bg-indigo-400 rounded hover:text-white" %>
      <%= link_to t(".signup"), signup_path,
      class: "w-auto text-center px-5 py-2 items-center justify-center border border-gray-500 hover:bg-indigo-400 rounded hover:text-white" %>
    </div>
  <% end %>
</div>
