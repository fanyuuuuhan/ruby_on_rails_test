<div class="flex gap-10">
    <div class="flex flex-col gap-5">
        <h1 class="font-bold text-3xl w-auto"><%= t(".title") %></h1>
        <% if @user %>
            <div class="flex flex-col gap-5">
            <p><%= t(".username") %>: <%= @user.name %></p>
            <p><%= t(".email") %>: <%= @user.email %></p>
            <p><%= t(".admin") %>: <%= @user.admin? ? t(".yes") : t(".no") %></p>
            </div>
        <% else %>
            <p><%= t(".no_users") %></p>
        <% end %>
        
        <div class="mt-5">
            <%= link_to t(".back"), admin_users_path,
                class: "px-5 py-2 bg-blue-100 hover:bg-blue-300 font-bold rounded" %>
        </div>
    </div>
    <div>
        <% if @user.tasks.any? %>
            <h2 class="font-bold text-2xl my-5"><%= t(".tasks") %></h2>
            <ul class="list-disc pl-5">
                <% @user.tasks.each do |task| %>
                    <li class="px-5 py-2 border border-gray-300 rounded mb-5">
                        <div class="flex gap-5 items-center">
                            <%= link_to task.title, task_path(task),
                                data: { turbo_frame: "_top" },
                                class: "font-bold" %>
                            - <%= t("tasks.show.show_status") %>: 
                            <%= t("tasks.form.#{task.status}") %>,
                            <%= t("tasks.form.form_priority") %>:
                            <%= t("tasks.form.#{task.priority}") %>
                        </div>
                    </li>
                <% end %>
            </ul>
        <% else %>
            <p><%= t(".no_tasks") %></p>
        <% end %>
    </div>
</div>