<div class="w-full flex flex-col gap-2">
    <div class="w-full flex flex-col gap-3">
        <h1 class="font-bold text-3xl"><%= t('.title') %></h1>
        <p><%= t('.users_count') %>: <%= @users.size %></p>
        <% if @users.any? %>
        <table class="table-auto w-full border-collapse border border-gray-300">
            <thead>
            <tr class="bg-gray-200">
                <th class="border border-gray-300 px-4 py-2"><%= t('.username') %></th>
                <th class="border border-gray-300 px-4 py-2"><%= t('.email') %></th>
                <th class="border border-gray-300 px-4 py-2"><%= t('.task_count') %></th>
                <th class="border border-gray-300 px-4 py-2"><%= t('.admin') %></th>
                <th class="border border-gray-300 px-2 py-2"><%= t('.edit') %></th>
                <th class="border border-gray-300 px-2 py-2"><%= t('.delete') %></th>
            </tr>
            </thead>
            <tbody>
            <% @users.each do |user| %>
                <tr>
                    <td class="border border-gray-300 px-4 py-2"><%= link_to user.name, admin_user_path(user) %></td>
                    <td class="border border-gray-300 px-4 py-2"><%= user.email %></td>
                    <td class="border border-gray-300 px-4 py-2"><%= user.tasks.size %></td>
                    <td class="border border-gray-300 px-4 py-2"><%= user.admin? ? t('.yes') : t('.no') %></td>
                    <td class="border border-gray-300 text-center align-middle">
                        <%= link_to t('.edit_button'), edit_admin_user_path(user), class: "px-4 py-2" %>
                    </td>
                    <td class="border border-gray-300 text-center align-middle">
                        <%= button_to t('.delete_button'), admin_user_path(user), method: :delete, data: { confirm: t('.delete_check') }, class: "px-4 py-2" %>
                    </td>
                </tr>
            <% end %>
            </tbody>
        </table>
        <% else %>
        <p><%= t('.no_users') %></p>
        <% end %>
    </div>
    <div>
        <% flash.each do |type, message| %>
            <div class="alert alert-<%= type %> text-red-600 items-center justify-center">
            <%= message %>
            </div>
        <% end %>
    </div>
    <div class="my-3 mr-2 flex justify-between">
        <%= link_to t('.back'), tasks_path,
            class: "px-5 py-2 bg-gray-100 hover:bg-gray-300 font-bold rounded" %>
        <%= link_to t('.new'), new_admin_user_path,
            class: "px-5 py-2 bg-blue-100 hover:bg-blue-300 font-bold rounded" %>
    </div>
</div>